DISCORD_TOKEN=paste-your-bot-token-here
CHANNEL_ID=your-discord-channel-id
GUILD_ID=your-discord-server-id

# Optional: private channel for health reports / dry-run / review
MOD_CHANNEL_ID=

# 0 = AI verifies extreme claims (recommended)
# 1 = Approve/Reject buttons in mod channel
REQUIRE_HUMAN_REVIEW=0

# AI (Gemini preferred)
GEMINI_API_KEY=
