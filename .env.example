# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional event APIs (stronger "what happened yesterday")
# FOOTBALL_DATA_API_KEY=
# THESPORTSDB_API_KEY=123

# Product options
SPOILER_SCORES=0
THREAD_DETAILS=1
ROLE_PING_ID=
HINGLISH_INDIA=0
FEED_CACHE_MINUTES=8
LOG_LEVEL=INFO
